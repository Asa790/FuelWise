# Database (MariaDB / MySQL)
DATABASE_URL="mysql://fuelwise:CHANGE_ME@localhost:3306/fuelwise"

# JWT secret (generate random 64+ char string)
JWT_SECRET="CHANGE_ME_TO_RANDOM_64_CHAR_STRING"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000

# Optional: OpenRouteService API key (default uses OSRM public demo)
ORS_API_KEY=""

# Nominatim / OSM User-Agent (required by Nominatim ToS)
NOMINATIM_USER_AGENT="FuelWiseApp/1.0 (contact@example.com)"
