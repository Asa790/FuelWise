// Fuel Wise — Prisma schema (MariaDB / MySQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(100)
  email         String   @unique @db.VarChar(150)
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  avatarUrl     String?  @map("avatar_url") @db.VarChar(500)
  monthlyBudget Int      @default(0) @map("monthly_budget")
  themePref     String   @default("dark") @map("theme_pref") @db.VarChar(10)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  vehicles Vehicle[]
  trips    Trip[]

  @@map("users")
}

model Vehicle {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  nickname         String?  @db.VarChar(100)
  brand            String   @db.VarChar(50)
  model            String   @db.VarChar(100)
  year             Int
  fuelType         String   @map("fuel_type") @db.VarChar(30)
  efficiencyKmpl   Decimal  @map("efficiency_kmpl") @db.Decimal(5, 2)
  customEfficiency Decimal? @map("custom_efficiency") @db.Decimal(5, 2)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips Trip[]

  @@index([userId])
  @@map("vehicles")
}

model FuelPrice {
  id            String   @id @default(cuid())
  fuelType      String   @unique @map("fuel_type") @db.VarChar(30)
  pricePerLiter Int      @map("price_per_liter")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("fuel_prices")
}

model VehicleSpec {
  id                    String   @id @default(cuid())
  brand                 String   @db.VarChar(50)
  model                 String   @db.VarChar(100)
  yearStart             Int      @map("year_start")
  yearEnd               Int?     @map("year_end")
  engineCc              Int?     @map("engine_cc")
  fuelTypeRecommended   String   @map("fuel_type_recommended") @db.VarChar(30)
  efficiencyCity        Decimal? @map("efficiency_city") @db.Decimal(5, 2)
  efficiencyHighway     Decimal? @map("efficiency_highway") @db.Decimal(5, 2)
  efficiencyAvg         Decimal  @map("efficiency_avg") @db.Decimal(5, 2)

  @@index([brand])
  @@index([brand, model])
  @@map("vehicle_specs")
}

model Trip {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  vehicleId           String?  @map("vehicle_id")

  originLat           Decimal? @map("origin_lat") @db.Decimal(10, 7)
  originLng           Decimal? @map("origin_lng") @db.Decimal(10, 7)
  originName          String?  @map("origin_name") @db.VarChar(255)
  destinationLat      Decimal  @map("destination_lat") @db.Decimal(10, 7)
  destinationLng      Decimal  @map("destination_lng") @db.Decimal(10, 7)
  destinationName     String   @map("destination_name") @db.VarChar(255)

  startedAt           DateTime @map("started_at")
  endedAt             DateTime? @map("ended_at")
  durationSeconds     Int?     @map("duration_seconds")

  distanceKm          Decimal? @map("distance_km") @db.Decimal(8, 2)
  fuelLiters          Decimal? @map("fuel_liters") @db.Decimal(8, 3)
  fuelCostIdr         Int?     @map("fuel_cost_idr")
  fuelPriceSnapshot   Int?     @map("fuel_price_snapshot")
  efficiencyKmpl      Decimal? @map("efficiency_kmpl") @db.Decimal(5, 2)
  fuelTypeSnapshot    String?  @map("fuel_type_snapshot") @db.VarChar(30)
  co2Kg               Decimal? @map("co2_kg") @db.Decimal(8, 3)

  status              String   @default("active") @db.VarChar(20)
  isFavourite         Boolean  @default(false) @map("is_favourite")

  routePoints         Json?    @map("route_points")

  createdAt           DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([userId, status])
  @@map("trips")
}
